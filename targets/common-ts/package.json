{
  "name": "@defenter/common-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities and types for Defenter targets",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./watcher": {
      "types": "./dist/watcher/index.d.ts",
      "default": "./dist/watcher/index.js"
    },
    "./mcp/monitor": {
      "types": "./dist/mcp/monitor/index.d.ts",
      "default": "./dist/mcp/monitor/index.js"
    },
    "./hooks/monitor": {
      "types": "./dist/hooks/monitor/index.d.ts",
      "default": "./dist/hooks/monitor/index.js"
    },
    "./hooks/initialize": {
      "types": "./dist/hooks/initialize.d.ts",
      "default": "./dist/hooks/initialize.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./console": {
      "types": "./dist/console.d.ts",
      "default": "./dist/console.js"
    },
    "./uv": {
      "types": "./dist/uv.d.ts",
      "default": "./dist/uv.js"
    }
  },
  "scripts": {
    "compile": "tsc",
    "prepare": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "jsonc-parser": "^3.3.1",
    "uuid": "^9.0.1"
  }
}
