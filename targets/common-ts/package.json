{
  "name": "@defenter/common-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities and types for Defenter targets",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./watcher": {
      "types": "./dist/watcher/index.d.ts",
      "default": "./dist/watcher/index.js"
    },
    "./discovery/cursorStorageParser": {
      "types": "./dist/discovery/cursorStorageParser.d.ts",
      "default": "./dist/discovery/cursorStorageParser.js"
    },
    "./monitors/configurationMonitor": {
      "types": "./dist/monitors/configurationMonitor/index.d.ts",
      "default": "./dist/monitors/configurationMonitor/index.js"
    },
    "./monitors/cursorHooksMonitor": {
      "types": "./dist/monitors/cursorHooksMonitor/index.d.ts",
      "default": "./dist/monitors/cursorHooksMonitor/index.js"
    }
  },
  "scripts": {
    "compile": "tsc",
    "prepare": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "jsonc-parser": "^3.3.1",
    "uuid": "^9.0.1"
  }
}
